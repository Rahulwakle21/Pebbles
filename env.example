# Copy to .env.local and fill in values before running locally or deploying.

# Where lead-form submissions are delivered.
# With onboarding@resend.dev (no verified domain), Resend only delivers to your Resend account email.
CONTACT_TO_EMAIL=waklerahul21@gmail.com

# Sender address — use onboarding@resend.dev for testing without a verified domain.
# For production, verify your domain in Resend and use e.g. "Pebbles Leads <leads@yourdomain.com>"
RESEND_FROM_EMAIL=Pebbles Leads <onboarding@resend.dev>

# Local testing without Resend: set to "log" to print submissions in the terminal.
# Remove this line once RESEND_API_KEY is configured.
CONTACT_EMAIL_MODE=log

# Get your API key from https://resend.com/api-keys (required for real emails in production)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
